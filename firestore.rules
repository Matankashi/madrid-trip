// Firestore security rules — madrid-trip
//
// What this allows:
//   - A signed-in user (this project uses email/password auth) may
//     read and write ANY document under their own /users/{their uid}
//     subtree — not just the checklist. This was widened from a
//     single-document rule to make room for /state/budget (and any
//     future per-user state doc) without a rules change each time.
//
// What this blocks:
//   - Everything else in the database: any other user's /users/{uid}
//     subtree, and any path outside /users entirely.
//   - All unauthenticated access — reads and writes both.
//   - A signed-in user reading or writing another user's data, even
//     though the path pattern would otherwise match — only the path
//     segment (bound to request.auth.uid) is trusted, never the
//     document body.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Documentation only — not doing any security work. Firestore
    // denies any path with no matching `allow` by default, and rules
    // are a union across all matching blocks, so this `if false` can't
    // revoke access the rule above already granted; it exists purely
    // to make the "everything else is unreachable" intent explicit to
    // a reader.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
